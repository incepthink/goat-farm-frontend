# Copy to .env.local and fill in. Neither variable is required to run the site —
# both features degrade to a clearly-labelled "not connected" state without them.

# Where every form on the site POSTs. A Formspree / Web3Forms style endpoint URL.
# Without it, forms validate and behave normally but tell the visitor to email instead.
# See docs/CLIENT-QUESTIONS.md §1.
VITE_FORM_ENDPOINT=

# Payment gateway. Leave empty to run the donate page against the mock adapter, which is
# the intended state until the client confirms a gateway and supplies an account.
# When set, src/lib/payments/ switches to the live provider.
VITE_PAYMENT_PROVIDER=
VITE_RAZORPAY_KEY_ID=
